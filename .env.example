# NEXUS Media Backend Configuration Example
# Copy to .env (which is gitignored) or export variables in your shell before running uvicorn.
# All variables use the NEXUS_MEDIA_ prefix.

# Bind address (keep 127.0.0.1 for local use and behind Tailscale Serve)
NEXUS_MEDIA_HOST=127.0.0.1
NEXUS_MEDIA_PORT=8000

# Optional private access token for protecting API, SSE, and file downloads
# Leave empty for open localhost-only development; set a long random value when using Tailscale Serve
NEXUS_MEDIA_ACCESS_TOKEN=

# Resource & processing limits
NEXUS_MEDIA_MAX_FILE_SIZE_BYTES=524288000
NEXUS_MEDIA_MAX_DURATION_SECONDS=3600
NEXUS_MEDIA_MAX_CONCURRENT_JOBS=3
NEXUS_MEDIA_JOB_TTL_SECONDS=3600
NEXUS_MEDIA_RATE_LIMIT_PER_MINUTE=45
NEXUS_MEDIA_SUBPROCESS_TIMEOUT_SECONDS=300

# Custom storage paths (defaults to backend/tmp_jobs and backend/storage/nexus_media.db)
# NEXUS_MEDIA_STORAGE_ROOT=/path/to/tmp_jobs
# NEXUS_MEDIA_DATABASE_PATH=/path/to/nexus_media.db

# SECURITY: NEVER set to true in production! Used only by automated pytest/Playwright test harnesses.
NEXUS_MEDIA_ALLOW_LOOPBACK_FOR_TESTS=false
